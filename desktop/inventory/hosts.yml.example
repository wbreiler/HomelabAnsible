---
all:
  children:
    gaming_pc:
      hosts:
        orion:
          ansible_host: 192.168.1.221
          # gaming_pc_clips_gateway: 192.0.2.1  # Set to the on-link router for Clips.
      vars:
        ansible_user: 'ORION\ansible'
        ansible_password: "{{ gaming_pc_ansible_password }}"
        ansible_connection: winrm
        ansible_port: 5985
        ansible_winrm_scheme: http
        ansible_winrm_transport: ntlm
        ansible_winrm_server_cert_validation: ignore
