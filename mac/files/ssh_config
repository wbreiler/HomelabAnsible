# Arista: agent-held cluster key, with password fallback
Host 192.168.1.222
  User admin
  IdentityFile ~/.ssh/cluster.pub
  IdentitiesOnly yes
  PreferredAuthentications publickey,password
  PubkeyAuthentication yes

# Use a local 1Password agent when present. Otherwise keep SSH_AUTH_SOCK.
Match exec "/bin/test -S \"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
