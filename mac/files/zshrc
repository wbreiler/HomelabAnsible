# Environment and command paths.
export ZSH="$HOME/.oh-my-zsh"
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
export PYENV_ROOT="$HOME/.pyenv"

# Zsh keeps PATH synchronized with this array and removes duplicates.
typeset -U path PATH
path=(
    "$HOME/.local/bin"
    "$HOME/.antigravity/antigravity/bin"
    "$HOME/.cargo/bin"
    /opt/homebrew/opt/openjdk/bin
    $path
    "$HOME/.lmstudio/bin"
    /usr/local/go/bin
)
[[ -d "$PYENV_ROOT/bin" ]] && path=("$PYENV_ROOT/bin" $path)

# Oh My Zsh.
ZSH_THEME="apple"
zstyle ':omz:update' mode auto
plugins=(
    git alias-finder battery wakeonlan thefuck tailscale systemadmin
    macos gitignore docker docker-compose colored-man-pages catimg web-search
)
source "$ZSH/oh-my-zsh.sh"

# Language tools.
if (( $+commands[pyenv] )); then
    eval "$(pyenv init -)"
fi
if (( $+commands[go] )); then
    path+=("$(go env GOPATH)/bin")
fi

