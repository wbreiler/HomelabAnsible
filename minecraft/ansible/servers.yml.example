---
# Copy to servers.yml and define the Minecraft LXCs for your environment.

servers:
  - hostname: example-minecraft
    # Current guest address used by site.yml for existing-server reconciliation.
    ansible_host: 192.0.2.31
    vmid: 124
    node: node1
    # Optional Proxmox HA placement. The first node has the highest priority;
    # equal lower priorities allow either fallback node. auto_rebalance=false
    # prevents load-balancing migrations while the preferred node is healthy.
    ha_enabled: true
    ha_nodes:
      - node1:100
      - node2:10
      - node3:10
    ha_strict: true
    ha_failback: false
    ha_auto_rebalance: false
    # Set only when safely splitting this server out of an existing shared rule.
    # ha_detach_from_rule: ha-rule-existing-shared
    cores: 4
    memory: 8192
    disk: 32
    pack_source: modrinth
    modpack_slug: vanilla
    pack_name: Example Minecraft Server
    mc_version: "1.21.1"
    loader: ""
    instance_name: example
    # Optional Distant Horizons LOD pre-generation. A cron-launched controller
    # pauses within about five seconds when a player joins and resumes when the
    # server is empty. Its RCON password is generated on the LXC and never
    # stored in this inventory.
    dh_pregen_enabled: false
    dh_pregen_dimension: overworld
    dh_pregen_center_x: 0
    dh_pregen_center_z: 0
    dh_pregen_radius: 500
    # Standalone Modrinth mods layered on top of the pack (e.g. an add-on the
    # pack author doesn't bundle). Resolved to each mod's latest release for
    # this server's mc_version/loader; works with either pack_source.
    # extra_modrinth_mods:
    #   - dynamictrees
    xmx: 6G
    xms: 2G
    server_properties:
      difficulty: normal
      max_players: 20
      online_mode: true
    ops: []

  # CurseForge example:
  # - hostname: example-modpack
  #   ansible_host: 192.0.2.32
  #   vmid: 302
  #   node: node1
  #   cores: 4
  #   memory: 8192
  #   disk: 32
  #   pack_source: curseforge
  #   curseforge_project_id: "123456"
  #   modpack_slug: example-pack
  #   pack_name: Example Modpack
  #   mc_version: "1.20.1"
  #   loader: forge
  #   instance_name: example-pack
  #   discord_webhook_url: "{{ vault_discord_webhook_example }}"
  #   xmx: 6G
  #   xms: 2G

  # pack_source: manual — recommended when the CurseForge/Modrinth auto-fetch
  # reconstruction of a pack misbehaves in ways that aren't an obvious single-mod
  # config bug. Disables update-modpack.sh entirely (no auto-fetch, no update
  # timer). Requires loader_version (exact Forge/NeoForge version — from the
  # zip's variables.txt/manifest.json, or auto-reported by apply-manual-pack.sh
  # when using a .mrpack). Deploy mods/config/defaultconfigs/datapacks with
  # update-script/apply-manual-pack.sh <pack.zip|pack.mrpack> root@<ansible_host>
  # — it handles both CurseForge server-pack zips and Modrinth .mrpack files.
  # See minecraft/CLAUDE.md for the full procedure.
  # - hostname: example-manual-pack
  #   ansible_host: 192.0.2.33
  #   vmid: 303
  #   node: node1
  #   cores: 4
  #   memory: 8192
  #   disk: 32
  #   pack_source: manual
  #   modpack_slug: example-pack
  #   pack_name: Example Modpack
  #   mc_version: "1.20.1"
  #   loader: forge
  #   loader_version: "47.4.20"
  #   instance_name: example-manual-pack
  #   xmx: 6G
  #   xms: 2G
