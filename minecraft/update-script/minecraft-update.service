[Unit]
Description=Minecraft modpack update check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/update-modpack.sh
# Capture stdout/stderr through the journal (journalctl -u minecraft-update.service)
StandardOutput=journal
StandardError=journal
# Root controls systemd and credentials. Game-file operations run as minecraft.
User=root

# Keep the service unit visible in the journal even after it finishes
RemainAfterExit=no
