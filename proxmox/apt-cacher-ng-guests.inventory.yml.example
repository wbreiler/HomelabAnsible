---
all:
  children:
    apt_cacher_ng_guests:
      vars:
        ansible_ssh_private_key_file: ~/.ssh/lxc.pub
        ansible_python_interpreter: /usr/bin/python3
      hosts:
        example_lxc:
          ansible_host: 192.0.2.10
          ansible_user: root
        example_vm:
          ansible_host: 192.0.2.11
          ansible_user: ansible
