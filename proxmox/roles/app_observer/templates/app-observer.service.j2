[Unit]
Description=Read-only application health and filtered diagnostic observations
After=network-online.target loki.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=config:/etc/app-observer.json
ExecStart=/usr/bin/python3 /opt/app-observer/server.py %d/config
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
