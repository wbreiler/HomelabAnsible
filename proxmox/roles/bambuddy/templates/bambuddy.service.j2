[Unit]
Description=Bambuddy - Bambu Lab Print Management
Documentation=https://github.com/maziggy/bambuddy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bambuddy
Group=bambuddy
WorkingDirectory={{ bambuddy_install_dir }}
EnvironmentFile={{ bambuddy_install_dir }}/.env
ExecStart={{ bambuddy_install_dir }}/venv/bin/uvicorn backend.app.main:app --host {{ bambuddy_bind_host }} --port {{ bambuddy_port }} --loop asyncio --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
