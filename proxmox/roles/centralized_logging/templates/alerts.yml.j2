apiVersion: 1
groups:
  - orgId: 1
    name: Homelab logs
    folder: Homelab
    interval: 1m
    rules:
{% for rule in [
  {'uid': 'homelab-ingestion-stopped', 'title': 'No incoming homelab logs',
   'expr': 'absent_over_time({host=~"prometheus|atlas"}[10m])', 'threshold': 0,
   'summary': 'Neither Proxmox host has supplied a log for ten minutes.'},
  {'uid': 'homelab-proxy-errors', 'title': 'Reverse proxy error spike',
   'expr': 'sum(count_over_time({host="npm-nash", job="nginx-proxy-manager"} |~ `(?i)(\\[error\\]|\\[crit\\]|\\[alert\\]|\\[emerg\\])` [5m]))', 'threshold': 25,
   'summary': 'NPM emitted more than 25 error lines in five minutes.'}
] %}
      - uid: {{ rule.uid }}
        title: {{ rule.title }}
        condition: C
        for: 2m
        noDataState: OK
        execErrState: Error
        annotations:
          summary: {{ rule.summary | to_json }}
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange: {from: 600, to: 0}
            model:
              refId: A
              expr: {{ rule.expr | to_json }}
              queryType: instant
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            relativeTimeRange: {from: 0, to: 0}
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
              settings: {mode: dropNN}
          - refId: C
            datasourceUid: __expr__
            relativeTimeRange: {from: 0, to: 0}
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: {type: gt, params: [{{ rule.threshold }}]}
                  operator: {type: and}
                  reducer: {type: last}
                  type: query
{% endfor %}
