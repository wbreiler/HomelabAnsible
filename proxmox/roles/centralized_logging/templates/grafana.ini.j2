[server]
http_addr = 0.0.0.0
http_port = 3000
domain = {{ centralized_logging_grafana_hostname }}
root_url = http://{{ centralized_logging_grafana_hostname }}/

[security]
admin_user = admin
admin_password = $__file{/etc/grafana/admin-password}
cookie_secure = false

[analytics]
enabled = false
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[users]
allow_sign_up = false
