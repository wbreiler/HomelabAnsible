# This nginx instance serves only the Loki ingestion endpoint.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 512;
}

http {
    access_log off;

    server {
        listen 0.0.0.0:3100;
        server_name _;
        client_max_body_size 0;

        allow 127.0.0.1/32;
        allow {{ centralized_logging_ip }}/32;
{% for source in centralized_logging_ingest_cidrs | unique %}
        allow {{ source }};
{% endfor %}
        deny all;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_request_buffering off;

        location = /loki/api/v1/push {
            if ($request_method != POST) { return 405; }
            proxy_pass http://127.0.0.1:3101/loki/api/v1/push;
        }

        location = /ready {
            if ($request_method != GET) { return 405; }
            proxy_pass http://127.0.0.1:3101/ready;
        }

        location / {
            return 403;
        }
    }
}
