import json
import os
from pathlib import Path
import pwd
import secrets
import socket

import bcrypt

env = Path('/opt/homelable/app/backend/.env')
if not env.exists():
    os.umask(0o077)
    password = secrets.token_urlsafe(24)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as connection:
        connection.connect(('192.0.2.1', 80))
        address = connection.getsockname()[0]
    values = {
        'SECRET_KEY': secrets.token_hex(32),
        'SQLITE_PATH': '/var/lib/homelable/homelab.db',
        'CORS_ORIGINS': json.dumps(['http://localhost:{{ homelable_port }}', f'http://{address}:{{ homelable_port }}']),
        'AUTH_USERNAME': 'admin',
        'AUTH_PASSWORD_HASH': bcrypt.hashpw(password.encode(), bcrypt.gensalt()).decode(),
        'SCANNER_RANGES': json.dumps({{ homelable_scanner_ranges | to_json }}),
        'STATUS_CHECKER_INTERVAL': '60',
    }
    # Keep the bootstrap password on the container only, outside logs and argv.
    Path('/root/homelable-admin-password').write_text(password + '\n')
    env.write_text(''.join(f"{key}='{value}'\n" for key, value in values.items()))
    account = pwd.getpwnam('homelable')
    os.chown(env, account.pw_uid, account.pw_gid)
    print('created')
