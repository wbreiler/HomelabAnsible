+
+test('Steam approval is sent once for concurrent and delayed duplicate callers', async (context) => {
+  const api = await loadApi('device-confirmation-once');
+  const calls = [];
+  let complete;
+  context.mock.method(globalThis, 'fetch', async (_url, options) => {
+    calls.push(JSON.parse(options.body));
+    await new Promise((resolve) => {
+      complete = resolve;
+    });
+    return new Response('{}', { status: 200 });
+  });
+  const challenge = { credentialType: 'device-confirmation', challengeId: 'approval-1' };
+  const first = api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1');
+  const duplicate = api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1');
+  assert.equal(calls.length, 1);
+  complete();
+  await Promise.all([first, duplicate]);
+  await api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1');
+  assert.equal(calls.length, 1);
+});
+
+test('approval errors reach both callers without a duplicate request', async (context) => {
+  const api = await loadApi('device-confirmation-rejected');
+  let calls = 0;
+  context.mock.method(console, 'error', () => undefined);
+  context.mock.method(globalThis, 'fetch', async () => {
+    calls++;
+    return new Response(JSON.stringify({ error: 'credential_rejected', state: 'active' }), {
+      status: 409
+    });
+  });
+  const challenge = { credentialType: 'device-confirmation', challengeId: 'approval-rejected' };
+  const results = await Promise.allSettled([
+    api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1'),
+    api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1')
+  ]);
+  assert.equal(calls, 1);
+  assert.ok(
+    results.every(
+      (result) =>
+        result.status === 'rejected' && result.reason.cause.error === 'credential_rejected'
+    )
+  );
+});
+
+test('new approvals and sessions stay separate and ordinary credentials are not deduplicated', async (context) => {
+  const api = await loadApi('device-confirmation-isolation');
+  let calls = 0;
+  context.mock.method(globalThis, 'fetch', async () => {
+    calls++;
+    return new Response('{}', { status: 200 });
+  });
+  const challenge = { credentialType: 'device-confirmation', challengeId: 'approval-separate' };
+  await api.providePersistentCredential('Steam', challenge, 'confirm', 'session-1');
+  await api.providePersistentCredential('Steam', challenge, 'confirm', 'session-2');
+  await api.providePersistentCredential(
+    'Steam',
+    { ...challenge, challengeId: 'approval-next' },
+    'confirm',
+    'session-2'
+  );
+  const password = { credentialType: 'password', challengeId: 'password-1' };
+  await api.providePersistentCredential('Steam', password, 'test-only', 'session-2');
+  await api.providePersistentCredential('Steam', password, 'test-only', 'session-2');
+  assert.equal(calls, 5);
+});
