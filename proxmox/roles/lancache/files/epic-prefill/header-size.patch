diff --git a/EpicPrefill/Handlers/ChunkResponseValidator.cs b/EpicPrefill/Handlers/ChunkResponseValidator.cs
new file mode 100644
index 0000000..b6511e2
--- /dev/null
+++ b/EpicPrefill/Handlers/ChunkResponseValidator.cs
@@ -0,0 +1,52 @@
+using System.Buffers.Binary;
+
+namespace EpicPrefill.Handlers;
+
+internal static class ChunkResponseValidator
+{
+    internal const int MaxChunkBytes = 8 * 1024 * 1024;
+
+    // shortcut: accept only the verified four-byte version-3 expansion; extend for another observed format.
+    internal static bool IsValidHeaderExpansion(byte[] data, ulong expectedSize, byte[] expectedSha1)
+    {
+        if (expectedSha1.Length != 20 || expectedSize > MaxChunkBytes
+            || (ulong)data.Length != expectedSize + 4 || data.Length < 66
+            || BinaryPrimitives.ReadUInt32LittleEndian(data) != 0xB1FE3AA2
+            || BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(4)) != 3
+            || BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(8)) != 66
+            || BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(12)) != data.Length - 66
+            || !data.AsSpan(41, 20).SequenceEqual(expectedSha1))
+        {
+            return false;
+        }
+
+        uint plainSize = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(62));
+        if (plainSize == 0 || plainSize > MaxChunkBytes || data[40] > 1)
+        {
+            return false;
+        }
+
+        try
+        {
+            using var payload = new MemoryStream(data, 66, data.Length - 66, writable: false);
+            using Stream decoded = data[40] == 1
+                ? new ZLibStream(payload, CompressionMode.Decompress) : payload;
+            // SHA-1 is the content identity supplied by Epic's manifest format.
+            using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA1);
+            var buffer = new byte[8192];
+            int total = 0;
+            int read;
+            while ((read = decoded.Read(buffer, 0, buffer.Length)) != 0)
+            {
+                total += read;
+                if (total > plainSize) return false;
+                hash.AppendData(buffer, 0, read);
+            }
+            return total == plainSize && hash.GetHashAndReset().AsSpan().SequenceEqual(expectedSha1);
+        }
+        catch (InvalidDataException)
+        {
+            return false;
+        }
+    }
+}
diff --git a/EpicPrefill.Test/ChunkResponseValidatorTests.cs b/EpicPrefill.Test/ChunkResponseValidatorTests.cs
new file mode 100644
index 0000000..6ae3c0b
--- /dev/null
+++ b/EpicPrefill.Test/ChunkResponseValidatorTests.cs
@@ -0,0 +1,107 @@
+using System.Buffers.Binary;
+using System.IO.Compression;
+using System.Security.Cryptography;
+using EpicPrefill.Handlers;
+using EpicPrefill.Models;
+using EpicPrefill.Models.ApiResponses;
+using Spectre.Console;
+using System.Net;
+
+namespace EpicPrefill.Test;
+
+public sealed class ChunkResponseValidatorTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task DownloaderAcceptsOnlyVerifiedExpansion(bool wrongHash)
+    {
+        var (data, hash) = Chunk(true);
+        if (wrongHash) hash[0] ^= 0x40;
+        using var handler = new ChunkHandler(data);
+        var console = AnsiConsole.Create(new AnsiConsoleSettings
+        {
+            Ansi = AnsiSupport.No,
+            Interactive = InteractionSupport.No,
+            Out = new AnsiConsoleOutput(TextWriter.Synchronized(TextWriter.Null))
+        });
+        using var downloader = new DownloadHandler(console, handler, "127.0.0.1");
+        var requests = new List<QueuedRequest>
+        {
+            new() { DownloadUrl = "/chunk", DownloadSizeBytes = (ulong)data.Length - 4, ContentSha1 = hash }
+        };
+        bool result = await downloader.DownloadQueuedChunksAsync(requests,
+            new ManifestUrl { ManifestDownloadUrl = "http://example.test/build.manifest" });
+        Assert.Equal(!wrongHash, result);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void AcceptsCompleteLegacyHeaderExpansion(bool compressed)
+    {
+        var (data, hash) = Chunk(compressed);
+        Assert.True(ChunkResponseValidator.IsValidHeaderExpansion(data, (ulong)data.Length - 4, hash));
+    }
+
+    [Theory]
+    [InlineData("truncated")]
+    [InlineData("payload")]
+    [InlineData("manifest-hash")]
+    [InlineData("version")]
+    [InlineData("header-size")]
+    [InlineData("payload-size")]
+    [InlineData("plain-size")]
+    [InlineData("oversized")]
+    [InlineData("wrong-difference")]
+    public void RejectsInvalidContentAndOtherLengthChanges(string damage)
+    {
+        var (data, hash) = Chunk(true);
+        ulong size = (ulong)data.Length - 4;
+        switch (damage)
+        {
+            case "truncated": data = data[..^1]; break;
+            case "payload": data[100] ^= 0x40; break;
+            case "manifest-hash": hash[0] ^= 0x40; break;
+            case "version": data[4] = 2; break;
+            case "header-size": data[8] = 62; break;
+            case "payload-size": data[12] ^= 0x40; break;
+            case "plain-size": BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(62), 1); break;
+            case "oversized": BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(62), uint.MaxValue); break;
+            case "wrong-difference": size--; break;
+        }
+        Assert.False(ChunkResponseValidator.IsValidHeaderExpansion(data, size, hash));
+    }
+
+    private static (byte[] Data, byte[] Hash) Chunk(bool compressed)
+    {
+        byte[] plain = Enumerable.Range(0, 4096).Select(i => (byte)i).ToArray();
+        byte[] hash = SHA1.HashData(plain);
+        using var body = new MemoryStream();
+        if (compressed)
+        {
+            using (var zlib = new ZLibStream(body, CompressionLevel.Optimal, leaveOpen: true))
+                zlib.Write(plain);
+        }
+        else body.Write(plain);
+        byte[] payload = body.ToArray();
+        byte[] data = new byte[66 + payload.Length];
+        BinaryPrimitives.WriteUInt32LittleEndian(data, 0xB1FE3AA2);
+        BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(4), 3);
+        BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(8), 66);
+        BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(12), (uint)payload.Length);
+        data[40] = compressed ? (byte)1 : (byte)0;
+        hash.CopyTo(data, 41);
+        BinaryPrimitives.WriteUInt32LittleEndian(data.AsSpan(62), (uint)plain.Length);
+        payload.CopyTo(data, 66);
+        return (data, hash);
+    }
+
+    private sealed class ChunkHandler : HttpMessageHandler
+    {
+        private readonly byte[] _data;
+        public ChunkHandler(byte[] data) => _data = data;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+            => Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new ByteArrayContent(_data) });
+    }
+}
