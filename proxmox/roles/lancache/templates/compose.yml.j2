name: lancache
x-logging: &logging
  driver: json-file
  options: {max-size: 10m, max-file: "3"}
services:
  monolithic:
    image: {{ lancache_cache_image }}
    restart: unless-stopped
    logging: *logging
    labels:
      homelab.lancache-proxy-config: "{{ lancache_nginx_config_checksum }}"
    environment:
      UPSTREAM_DNS: "{{ lancache_upstream_dns }}"
      CACHE_DISK_SIZE: "{{ lancache_cache_gib }}g"
      CACHE_INDEX_SIZE: 250m
      MIN_FREE_DISK: "{{ lancache_free_gib }}g"
      CACHE_MAX_AGE: 3650d
      TZ: "{{ lancache_timezone }}"
    networks:
      public:
        ipv4_address: "{{ lancache_cache_ip }}"
      workers:
        ipv4_address: "{{ lancache_worker_cache_ip }}"
    volumes:
      - /srv/lancache/cache:/data/cache
      - /srv/lancache/logs:/data/logs
      - /opt/lancache/nginx-upstream.conf:/etc/lancache-upstream.conf:ro
      - /opt/lancache/nginx-cache-upstream.conf:/etc/lancache-cache-upstream.conf:ro
      - /opt/lancache/upstream-hook.sh:/hooks/entrypoint-pre.d/99_upstream.sh:ro
  upstream:
    image: {{ lancache_upstream_image }}
    restart: unless-stopped
    logging: *logging
    labels:
      homelab.lancache-proxy-config: "{{ lancache_haproxy_config_checksum }}"
    depends_on: [monolithic]
    network_mode: service:monolithic
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    volumes:
      - /opt/lancache/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
  dns:
    image: {{ lancache_dns_image }}
    restart: unless-stopped
    logging: *logging
    depends_on: [monolithic]
    network_mode: service:monolithic
    environment:
      USE_GENERIC_CACHE: "true"
      LANCACHE_IP: "{{ lancache_cache_ip }}"
      UPSTREAM_DNS: "{{ lancache_upstream_dns }}"
      TZ: "{{ lancache_timezone }}"
{% if lancache_phase == 'full' %}
  worker-dns:
    image: {{ lancache_dns_image }}
    restart: unless-stopped
    logging: *logging
    environment:
      USE_GENERIC_CACHE: "true"
      LANCACHE_IP: "{{ lancache_worker_cache_ip }}"
      UPSTREAM_DNS: "{{ lancache_upstream_dns }}"
      TZ: "{{ lancache_timezone }}"
    networks:
      workers:
        ipv4_address: "{{ lancache_worker_dns_ip }}"
  dashboard:
    image: {{ lancache_dashboard_image }}
    restart: unless-stopped
    logging: *logging
    labels:
      homelab.lancache-postgres-startup: "{{ lancache_postgres_config_checksum }}"
    depends_on: [worker-dns]
    dns: ["{{ lancache_worker_dns_ip }}"]
    env_file: [/srv/lancache/dashboard/database.env]
    environment:
      # Nginx creates cache files mode 0600. Share its UID on the guest filesystem.
      PUID: "33"
      PGID: "33"
      # A slow durable commit must finish before EF retries the same session insert.
      ConnectionStrings__DefaultConnection: "Host=/var/run/postgresql;Database=lancache;Username=lancache;Command Timeout=120"
      Prefill__SteamDockerImage: "{{ lancache_steam_prefill_image }}"
      Prefill__EpicDockerImage: "{{ lancache_epic_prefill_image }}"
      Prefill__RiotDockerImage: "{{ lancache_riot_prefill_image }}"
      Prefill__NetworkMode: lancache-workers
      Prefill__LancacheIp: "{{ lancache_worker_cache_ip }}"
      Prefill__LancacheDnsIp: "{{ lancache_worker_dns_ip }}"
      TZ: "{{ lancache_timezone }}"
      LanCache__LogPath: /logs/access.log
      LanCache__CachePath: /cache/cache
      LanCache__EnvFilePath: /settings/lancache.env
      NginxLogRotation__Enabled: "true"
      NginxLogRotation__ContainerName: lancache-monolithic-1
    networks:
      public:
        ipv4_address: "{{ lancache_dashboard_ip }}"
      workers:
        ipv4_address: "{{ lancache_worker_dashboard_ip }}"
    volumes:
      - /srv/lancache/dashboard:/data
      # The image uses su - postgres, which reads PAM's environment, not Docker's.
      - /opt/lancache/postgres-environment:/etc/environment:ro
      - /srv/lancache/logs:/logs
      - /srv/lancache/cache:/cache
      - /srv/lancache/dashboard/lancache.env:/settings/lancache.env:ro
      - /var/run/docker.sock:/var/run/docker.sock:rw
{% endif %}
networks:
  public:
    name: lancache-public
    driver: macvlan
    driver_opts: {parent: "{{ ansible_facts.default_ipv4.interface }}"}
    ipam:
      config:
        - subnet: "{{ lancache_subnet }}"
          gateway: "{{ lancache_gateway }}"
  workers:
    name: lancache-workers
    driver: bridge
    ipam:
      config:
        - subnet: "{{ lancache_worker_subnet }}"
