FROM {{ lancache_epic_prefill_sdk_image }} AS build
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
WORKDIR /src
COPY epic.tar.gz common.tar.gz /sources/
RUN tar -xzf /sources/epic.tar.gz -C /src --strip-components=1 \
    && tar -xzf /sources/common.tar.gz -C /src/LancachePrefill.Common --strip-components=1
COPY header-size.patch /sources/
RUN git apply --whitespace=nowarn /sources/header-size.patch
RUN dotnet test EpicPrefill.Test/EpicPrefill.Test.csproj --configuration Release --logger 'console;verbosity=minimal'
RUN dotnet publish EpicPrefill/EpicPrefill.csproj --configuration Release --runtime linux-x64 \
    --self-contained true -p:VersionSuffix=header3.1 --output /publish

FROM {{ lancache_epic_prefill_base_image }}
COPY --from=build /publish/EpicPrefill /app/EpicPrefill
