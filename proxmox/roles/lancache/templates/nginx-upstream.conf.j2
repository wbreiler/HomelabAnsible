# Reuse the local redirect connection for adjacent disk-cache slices.
upstream lancache_redirect {
    server 127.0.0.1:3128;
    keepalive 64;
}

# HAProxy reuses connections per CDN address and host.
upstream lancache_origins {
    server 127.0.0.1:3129;
    keepalive 64;
}

server {
    listen 127.0.0.1:3128;
    resolver {{ lancache_upstream_dns }} ipv6=off;
    error_log /data/logs/upstream-error.log;

    # The outer cache already buffers and writes the response.
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # A CDN may legally ignore Range. Normalize its full response before slicing.
    proxy_force_ranges on;

    location / {
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_pass http://lancache_origins$request_uri;
        proxy_intercept_errors on;
        error_page 301 302 307 = @upstream_redirect;
    }

    location @upstream_redirect {
        set $saved_upstream_location $upstream_http_location;
        proxy_pass $saved_upstream_location;
    }
}
