[Unit]
Description=Read maintenance failures and send explanatory Discord briefs
Wants=network-online.target
# Retain the manual drill's completed invocation for recovery collection.
After=network-online.target maintenance-repair-drill.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maintenance-briefs
User=root
Group=root
UMask=0077
StateDirectory=homelab-maintenance-briefs
StateDirectoryMode=0700
TimeoutStartSec=300
MemoryMax=256M
Nice=10
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/homelab-maintenance-briefs
