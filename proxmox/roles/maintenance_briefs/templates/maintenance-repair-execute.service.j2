[Unit]
Description=Execute one explicitly approved guarded maintenance attempt
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maintenance-repairs --execute
User=root
Group=root
UMask=0077
StateDirectory=homelab-maintenance-repairs
StateDirectoryMode=0700
# Never interrupt dpkg, vzdump, or an application deployment with a timeout.
TimeoutStartSec=infinity
Nice=10
# No timer, automatic restart, or install target: the controller starts this
# only after a concrete, unexpired proposal receives the owner's approval.
