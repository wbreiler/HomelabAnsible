+describe('app web UI links', () => {
+  it('makes the whole app node a keyboard-accessible link in a separate tab', async () => {
+    const user = userEvent.setup()
+    const nodes: Place[] = [
+      { id: 'nas', name: 'TrueNAS', parent: null },
+      { id: 'plex', name: 'Plex', parent: 'nas', status: 'ok', url: 'https://plex.example.com/web/index.html' },
+    ]
+    render(<TopologyCard data={{ status: 'ok', meta: { topology: { places: nodes } } } as unknown as WidgetData} />)
+    const link = screen.getByRole('link', { name: 'Plex' })
+    expect(link).toHaveAttribute('href', 'https://plex.example.com/web/index.html')
+    expect(link).toHaveAttribute('target', '_blank')
+    expect(link).toHaveAttribute('rel', 'noopener noreferrer')
+    expect(link.querySelector('rect')).not.toBeNull()
+    expect(screen.getByTestId('topology')).toHaveAttribute('role', 'group')
+    expect(screen.getAllByRole('link')).toHaveLength(1)
+    await user.tab()
+    expect(link).toHaveFocus()
+  })
+
+  it('keeps unsafe URLs and nodes without web UIs non-interactive', () => {
