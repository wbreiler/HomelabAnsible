[Unit]
Description=Prowlarr Daemon
After=network.target

[Service]
UMask=0002
Type=simple
User={{ prowlarr_user }}
Group={{ prowlarr_user }}
ExecStart={{ prowlarr_install_dir }}/Prowlarr -nobrowser -data={{ prowlarr_data_dir }}/
TimeoutStopSec=20
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
