[Unit]
Description=Spoolman
After=network.target

[Service]
Type=simple
WorkingDirectory={{ spoolman_install_dir }}
EnvironmentFile={{ spoolman_install_dir }}/.env
ExecStart=/usr/bin/bash {{ spoolman_install_dir }}/scripts/start.sh
Restart=always
User={{ spoolman_user }}
Group={{ spoolman_user }}

[Install]
WantedBy=multi-user.target
