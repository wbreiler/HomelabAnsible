# Managed screenshot ingress. The certificate uses the existing ACME webroot.
# Opt-in links must be withdrawable when the source leaves Shared.
map $uri $zipline_shared_cache_control {
    default "";
    ~^/(?:raw/|view/)?shared-[0-9a-f]+(?:[.][a-z0-9]+)?$ "private, no-store";
}
server {
    listen 80;
    listen [::]:80;
    server_name {{ zipline_domain }};
    include /etc/nginx/conf.d/include/letsencrypt-acme-challenge.conf;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ zipline_domain }};
    ssl_certificate /etc/letsencrypt/live/homelab-zipline/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/homelab-zipline/privkey.pem;
    client_max_body_size 26m;
    add_header Cache-Control $zipline_shared_cache_control always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
{% if zipline_discord_clip | default('') %}
    location ~ "^/view/{{ zipline_discord_clip.split('.')[0] }}(?:[.]mp4)?$" {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Accept-Encoding "";
        proxy_pass http://{{ zipline_ip.stdout | trim }}:{{ zipline_port }};
        sub_filter '<meta property="og:video:url" content="https://{{ zipline_domain }}/raw/'
                   '<meta property="og:video:url" content="https://{{ zipline_domain }}/discord-media/1080p/';
    }
    location ~ "^/discord-media/(?:(?:v2|1080p)/)?{{ zipline_discord_clip.split('.')[0] }}[.]mp4$" {
        proxy_buffering off;
        proxy_pass http://{{ zipline_ip.stdout | trim }}:3001;
    }
{% endif %}
    # The screenshot clients share both /<16-character name> and /<name>.png.
    location ~ "^/(?<zipline_screenshot>[A-Za-z0-9_-]{16})(?:[.]png)?$" {
        proxy_pass http://{{ zipline_ip.stdout | trim }}:{{ zipline_port }}/raw/$zipline_screenshot.png$is_args$args;
        proxy_intercept_errors on;
        error_page 401 403 404 = @zipline_file;
    }
    location @zipline_file {
        # Let Zipline handle protected files and extensionless names belonging to other media.
        proxy_pass http://{{ zipline_ip.stdout | trim }}:{{ zipline_port }};
    }
    location / {
        proxy_pass http://{{ zipline_ip.stdout | trim }}:{{ zipline_port }};
    }
}
