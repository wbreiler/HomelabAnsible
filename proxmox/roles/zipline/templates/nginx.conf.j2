# Managed screenshot ingress. The certificate uses the existing ACME webroot.
server {
    listen 80;
    listen [::]:80;
    server_name {{ zipline_domain }};
    include /etc/nginx/conf.d/include/letsencrypt-acme-challenge.conf;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ zipline_domain }};
    ssl_certificate /etc/letsencrypt/live/homelab-zipline/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/homelab-zipline/privkey.pem;
    client_max_body_size 26m;
    location / {
        proxy_pass http://{{ zipline_ip.stdout | trim }}:{{ zipline_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
    }
}
