# terraform plan -generate-config-out=guests.local.tf -out=adoption.tfplan
import {
  to = proxmox_virtual_environment_container.guest_100
  id = "your-node/100"
}

import {
  to = proxmox_virtual_environment_vm.guest_101
  id = "your-node/101"
}
