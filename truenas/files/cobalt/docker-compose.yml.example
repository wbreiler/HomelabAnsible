services:
  api:
    image: cobalt-api:a636575-hls1
    pull_policy: never
    init: true
    read_only: true
    restart: unless-stopped
    ports:
      - "192.0.2.10:9000:9000"
    environment:
      API_URL: http://192.0.2.10:9000/
      CORS_WILDCARD: "0"
      CORS_URL: http://192.0.2.10:9001
    healthcheck:
      test: [CMD, node, -e, "fetch('http://127.0.0.1:9000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
  web:
    image: cobalt-web:a636575
    pull_policy: never
    restart: unless-stopped
    ports:
      - "192.0.2.10:9001:8080"
    healthcheck:
      test: [CMD, wget, -q, --spider, http://127.0.0.1:8080/]
      interval: 30s
      timeout: 5s
      retries: 3
