---
# Copy to truenas.yml and customize for the target appliance.
truenas_expected_hostname: truenas

# Mutation remains disabled until discovery is reviewed and a backup exists.
truenas_allow_changes: false
truenas_allow_destructive_changes: false
truenas_allow_management_access_changes: false

# Required by playbooks/fastchannels.yml. Resolve this name through local DNS.
fastchannels_public_base_url: https://fastchannels.example.com
